{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>home-operations/renovate-presets#8.1.0',
    ':enablePreCommit',
    'mergeConfidence:all-badges',
    'github>home-operations/renovate-presets//apps/cnpg.json5#8.1.0',
  ],
  automerge: false,
  prConcurrentLimit: 5,
  timezone: 'America/Indiana/Indianapolis',
  assignees: ['jeversol'],
  packageRules: [
    {
      matchPackageNames: ['renovatebot/pre-commit-hooks', 'renovate/renovate'],
      groupName: 'renovate',
      matchUpdateTypes: ['patch', 'minor'],
      schedule: ['* 0-4 * * 1'],
      automerge: true,
      assignees: [],
    },
    {
      matchPackageNames: ['gitguardian/ggshield'],
      matchManagers: ['pre-commit'],
      matchUpdateTypes: ['patch', 'minor'],
      automerge: true,
      assignees: [],
    },
    {
      matchManagers: ['github-actions'],
      automerge: true,
      matchUpdateTypes: ['patch', 'minor', 'digest'],
      schedule: ['* 0-4 * * 1'],
      assignees: [],
    },
    {
      matchUpdateTypes: ['patch'],
      matchDatasources: ['docker', 'helm'],
      automerge: true,
      assignees: [],
    },
    {
      matchFileNames: ['tools/cluster-multitool/Dockerfile'],
      matchUpdateTypes: ['patch'],
      matchDatasources: ['pypi'],
      automerge: true,
      assignees: [],
    },
    {
      matchDatasources: ['docker'],
      matchPackageNames: ['homebridge/homebridge'],
      versioning: 'regex:^(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})$',
    },
    {
      matchPackageNames: ['ghcr.io/analogj/scrutiny'],
      matchCurrentValue: '/-web$/',
      versioning: 'regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-web$',
      groupName: 'scrutiny',
    },
    {
      matchPackageNames: ['ghcr.io/analogj/scrutiny'],
      matchCurrentValue: '/-collector$/',
      versioning: 'regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-collector$',
      groupName: 'scrutiny',
    },
    {
      matchPackageNames: ['csi-driver-nfs'],
      matchDatasources: ['helm'],
      changelogUrl: 'https://github.com/kubernetes-csi/csi-driver-nfs/releases',
    },
    {
      matchPackageNames: ['siderolabs/talos'],
      groupName: 'talos',
      automerge: false,
      assignees: ['jeversol'],
    },
    {
      matchPackageNames: [
        'ghcr.io/siderolabs/kubelet',
        'registry.k8s.io/kube-apiserver',
        'registry.k8s.io/kube-controller-manager',
        'registry.k8s.io/kube-scheduler',
        'registry.k8s.io/kubectl',
      ],
      groupName: 'kubernetes-components',
      versioning: 'semver',
      automerge: false,
      assignees: ['jeversol'],
    },
    {
      description: 'Avoid Kubernetes-manager extraction from generated and Kustomize files',
      matchManagers: ['kubernetes'],
      matchFileNames: [
        '**/kustomization.{yaml,yml}',
        'flux/flux-system/gotk*.{yaml,yml}',
      ],
      enabled: false,
    },
    {
      matchPackageNames: ['ghcr.io/cloudnative-pg/postgresql'],
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
    },
    {
      matchPackageNames: ['ghcr.io/cloudnative-pg/postgresql'],
      sourceUrl: 'https://github.com/cloudnative-pg/postgres-containers',
      changelogUrl: 'https://www.postgresql.org/docs/release/{{newVersion}}/',
    },
    {
      matchPackageNames: ['kubernetes-sigs/node-feature-discovery'],
      overrideDatasource: 'github-releases',
    },
    {
      matchPackageNames: ['kubernetes-csi/external-snapshotter'],
      overrideDatasource: 'github-releases',
    },
    {
      matchPackageNames: ['kubernetes-sigs/gateway-api'],
      overrideDatasource: 'github-releases',
    },
    {
      matchDatasources: ['docker'],
      matchPackageNames: ['/^factory\\.talos\\.dev\\//'],
      enabled: false,
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['/^flux\\/flux-system\\/flux-instance\\.yaml$/'],
      matchStrings: [
        'version:\\s+"(?<currentValue>\\d+\\.\\d+)\\.x"',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'fluxcd/flux2',
      extractVersionTemplate: '^v(?<version>\\d+\\.\\d+)',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/tools/cluster/base-controlplane\\.yaml/'],
      matchStrings: [
        'image:\\s+factory\\.talos\\.dev/metal-installer-secureboot/[a-f0-9]+:v(?<currentValue>\\d+\\.\\d+\\.\\d+)',
      ],
      datasourceTemplate: 'github-tags',
      depNameTemplate: 'siderolabs/talos',
      versioningTemplate: 'semver',
    },
  ],
}
