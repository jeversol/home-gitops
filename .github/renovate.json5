{
  flux: {
    enabled: true,
    managerFilePatterns: ['flux/**/*.{yaml,yml}'],
  },
  kubernetes: {
    managerFilePatterns: ['**/*.{yaml,yml}'],
    ignorePaths: ['**/kustomization.{yaml,yml}', 'flux/flux-system/gotk*.{yaml,yml}'],
  },
  extends: [
    'config:recommended',
    ':enablePreCommit',
    ':disableRateLimiting',
    'helpers:pinGitHubActionDigestsToSemver',
    'mergeConfidence:all-badges',
    'github>home-operations/renovate-presets//config/dependencyDashboard.json5#5.0.0',
    'github>home-operations/renovate-presets//managers/cnpg.json5#5.0.0',
    'github>home-operations/renovate-presets//policies/zer0ver.json5#5.0.0',
  ],
  automerge: false,
  timezone: 'America/Indiana/Indianapolis',
  assignees: ['jeversol'],
  packageRules: [
    {
      matchPackageNames: ['renovatebot/pre-commit-hooks', 'renovate/renovate'],
      groupName: 'renovate',
      matchUpdateTypes: ['patch', 'minor'],
      schedule: ['* 0-4 * * 1'],
      automerge: true,
      assignees: [],
    },
    {
      matchPackageNames: ['gitguardian/ggshield'],
      matchManagers: ['pre-commit'],
      matchUpdateTypes: ['patch', 'minor'],
      automerge: true,
      assignees: [],
    },
    {
      matchManagers: ['github-actions'],
      automerge: true,
      matchUpdateTypes: ['patch', 'minor', 'digest'],
      schedule: ['* 0-4 * * 1'],
      assignees: [],
    },
    {
      matchUpdateTypes: ['patch'],
      matchDatasources: ['docker', 'helm'],
      automerge: true,
      assignees: [],
      matchPackageNames: ['!kube-prometheus-stack'],
    },
    {
      matchFileNames: ['tools/cluster-multitool/Dockerfile'],
      matchUpdateTypes: ['patch'],
      matchDatasources: ['repology', 'pypi'],
      automerge: true,
      assignees: [],
    },
    {
      matchDatasources: ['docker'],
      matchPackageNames: ['homebridge/homebridge'],
      versioning: 'regex:^(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})$',
      allowedVersions: '/^\\d{4}-\\d{2}-\\d{2}$/',
    },
    {
      matchPackageNames: ['ghcr.io/analogj/scrutiny'],
      matchCurrentValue: '/-web$/',
      versioning: 'regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-web$',
      groupName: 'scrutiny',
    },
    {
      matchPackageNames: ['ghcr.io/analogj/scrutiny'],
      matchCurrentValue: '/-collector$/',
      versioning: 'regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-collector$',
      groupName: 'scrutiny',
    },
    {
      matchPackageNames: ['kube-prometheus-stack'],
      matchDatasources: ['helm'],
      matchUpdateTypes: ['patch', 'minor'],
      automerge: true,
      assignees: [],
    },
    {
      matchPackageNames: ['longhorn'],
      matchDatasources: ['helm'],
      changelogUrl: 'https://github.com/longhorn/longhorn/releases',
    },
    {
      matchPackageNames: ['cilium'],
      matchDatasources: ['helm'],
    },
    {
      matchPackageNames: ['csi-driver-nfs'],
      matchDatasources: ['helm'],
      changelogUrl: 'https://github.com/kubernetes-csi/csi-driver-nfs/releases',
    },
    {
      matchPackageNames: ['siderolabs/talos', 'ghcr.io/siderolabs/talosctl', 'ghcr.io/siderolabs/installer'],
      groupName: 'talos',
      automerge: false,
      assignees: ['jeversol'],
      postUpgradeTasks: {
        commands: [
          './.renovate/update-k8s-constraints.sh {{{newMajor}}}.{{{newMinor}}}'
        ],
        fileFilters: ['.github/renovate.json5'],
        executionMode: 'branch'
      }
    },
    {
      matchPackageNames: [
        'ghcr.io/siderolabs/kubelet',
        'registry.k8s.io/kube-apiserver',
        'registry.k8s.io/kube-controller-manager',
        'registry.k8s.io/kube-scheduler',
      ],
      groupName: 'kubernetes-components',
      automerge: false,
      assignees: ['jeversol'],
    },
    {
      matchPackageNames: ['ghcr.io/cloudnative-pg/postgresql'],
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
    },
    {
      matchPackageNames: ['kubernetes-sigs/node-feature-discovery'],
      overrideDatasource: 'github-releases',
    },
    {
      matchPackageNames: ['kubernetes-csi/external-snapshotter'],
      overrideDatasource: 'github-releases',
    },
    {
      matchPackageNames: ['kubernetes-sigs/gateway-api'],
      overrideDatasource: 'github-releases',
    },
    {
      matchPackageNames: ['kubernetes-sigs/external-dns'],
      overrideDatasource: 'github-releases',
    },
    {
      matchPackageNames: ['factory.talos.dev/metal-installer-secureboot/**'],
      matchManagers: ['kubernetes'],
      enabled: false,
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['**/*.{yaml,yml}'],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>.*?)\\s+depName=(?<depName>.*?)\\s*\\n\\s+version:\\s*v?(?<currentValue>[\\d.]+)',
      ],
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/tools/cluster-multitool/Dockerfile/'],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\sENV .*?_VERSION=\"(?<currentValue>.*)\"\\s',
      ],
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['^flux/flux-system/flux-instance\\.yaml$'],
      matchStrings: [
        'version:\\s+"(?<currentValue>\\d+\\.\\d+)\\.x"',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'fluxcd/flux2',
      extractVersionTemplate: '^v(?<version>\\d+\\.\\d+)',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/tools/cluster/base-controlplane\\.yaml/'],
      matchStrings: [
        '\\s+image:\\s+(?<depName>(?:ghcr\\.io|registry\\.k8s\\.io)/[^:]+):v(?<currentValue>\\d+\\.\\d+\\.\\d+)',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/tools/cluster/base-controlplane\\.yaml/'],
      matchStrings: [
        'image:\\s+factory\\.talos\\.dev/metal-installer-secureboot/[a-f0-9]+:v(?<currentValue>\\d+\\.\\d+\\.\\d+)',
      ],
      datasourceTemplate: 'github-tags',
      depNameTemplate: 'siderolabs/talos',
      versioningTemplate: 'semver',
    },
  ],
}
