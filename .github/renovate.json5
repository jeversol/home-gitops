{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>home-operations/renovate-presets#12.0.0',
    ':enablePreCommit',
    'mergeConfidence:all-badges',
    'github>home-operations/renovate-presets//apps/cnpg.json5#12.0.0',
  ],
  automerge: false,
  prConcurrentLimit: 5,
  timezone: 'America/Indiana/Indianapolis',
  assignees: ['jeversol'],
  packageRules: [
    {
      matchPackageNames: ['renovatebot/pre-commit-hooks', 'renovate/renovate'],
      groupName: 'renovate',
      matchUpdateTypes: ['patch', 'minor'],
      schedule: ['* 0-4 * * 1'],
      automerge: true,
      assignees: [],
    },
    {
      matchPackageNames: ['gitguardian/ggshield'],
      matchManagers: ['pre-commit'],
      matchUpdateTypes: ['patch', 'minor'],
      automerge: true,
      assignees: [],
    },
    {
      matchManagers: ['github-actions'],
      automerge: true,
      matchUpdateTypes: ['patch', 'minor', 'digest'],
      schedule: ['* 0-4 * * 1'],
      assignees: [],
    },
    {
      matchUpdateTypes: ['patch'],
      matchDatasources: ['docker', 'helm'],
      automerge: true,
      assignees: [],
    },
    {
      matchFileNames: ['tools/cluster-multitool/Dockerfile'],
      matchUpdateTypes: ['patch'],
      matchDatasources: ['pypi'],
      automerge: true,
      assignees: [],
    },
    {
      description: 'Distinguish the Python client from Kubernetes itself',
      matchDatasources: ['pypi'],
      matchPackageNames: ['kubernetes'],
      commitMessageTopic: 'dependency Python Kubernetes client',
    },
    {
      matchDatasources: ['docker'],
      matchPackageNames: ['homebridge/homebridge'],
      versioning: 'regex:^(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})$',
    },
    {
      matchPackageNames: ['ghcr.io/analogj/scrutiny'],
      matchCurrentValue: '/-web$/',
      versioning: 'regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-web$',
      groupName: 'scrutiny',
    },
    {
      matchPackageNames: ['ghcr.io/analogj/scrutiny'],
      matchCurrentValue: '/-collector$/',
      versioning: 'regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-collector$',
      groupName: 'scrutiny',
    },
    {
      description: 'Hold Sonarr on v4 until dependent tooling supports v5 (home-operations/containers#2002)',
      matchDatasources: ['docker'],
      matchPackageNames: ['ghcr.io/home-operations/sonarr'],
      allowedVersions: '/^4\\./',
    },
    {
      description: 'Track NFS CSI release tags and commits with the regex manager',
      matchManagers: ['flux'],
      matchFileNames: ['flux/infrastructure/nfs-csi-driver.yaml'],
      matchDatasources: ['git-refs'],
      enabled: false,
    },
    {
      matchPackageNames: ['siderolabs/talos'],
      groupName: 'talos',
      automerge: false,
      assignees: ['jeversol'],
    },
    {
      matchPackageNames: [
        'ghcr.io/siderolabs/kubelet',
        'registry.k8s.io/kube-apiserver',
        'registry.k8s.io/kube-controller-manager',
        'registry.k8s.io/kube-scheduler',
        'registry.k8s.io/kubectl',
      ],
      groupName: 'kubernetes-components',
      versioning: 'semver',
      automerge: false,
      assignees: ['jeversol'],
    },
    {
      description: 'Avoid Kubernetes-manager extraction from generated and Kustomize files',
      matchManagers: ['kubernetes'],
      matchFileNames: [
        '**/kustomization.{yaml,yml}',
        'flux/flux-system/gotk*.{yaml,yml}',
      ],
      enabled: false,
    },
    {
      matchPackageNames: ['ghcr.io/cloudnative-pg/postgresql'],
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
    },
    {
      matchPackageNames: ['ghcr.io/cloudnative-pg/postgresql'],
      sourceUrl: 'https://github.com/cloudnative-pg/postgres-containers',
      changelogUrl: 'https://www.postgresql.org/docs/release/{{newVersion}}/',
    },
    {
      description: 'Track SHA-pinned Kustomize bases with the release-aware regex manager',
      matchManagers: ['kustomize'],
      matchPackageNames: [
        'kubernetes-sigs/node-feature-discovery',
        'kubernetes-csi/external-snapshotter',
        'kubernetes-sigs/gateway-api',
      ],
      enabled: false,
    },
    {
      matchDatasources: ['docker'],
      matchPackageNames: ['/^factory\\.talos\\.dev\\//'],
      enabled: false,
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['flux/infrastructure/nfs-csi-driver.yaml'],
      matchStrings: ['commit: (?<currentDigest>[a-f0-9]{40}) # (?<currentValue>v[0-9]+[.][0-9]+[.][0-9]+)'],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'kubernetes-csi/csi-driver-nfs',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['infrastructure/**/kustomization.yaml'],
      matchStrings: [
        'https://github[.]com/(?<depName>[\\w.-]+/[\\w.-]+)/[^\\s?]+[?]ref=(?<currentDigest>[a-f0-9]{40})(?:&[^\\s]+)? # (?<currentValue>v[0-9]+[.][0-9]+[.][0-9]+)',
      ],
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/^flux\\/flux-system\\/flux-instance\\.yaml$/'],
      matchStrings: [
        'version:\\s+"(?<currentValue>\\d+\\.\\d+\\.\\d+)"',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'fluxcd/flux2',
      extractVersionTemplate: '^v(?<version>\\d+\\.\\d+\\.\\d+)$',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/tools/cluster/base-controlplane\\.yaml/'],
      matchStrings: [
        'image:\\s+factory\\.talos\\.dev/metal-installer-secureboot/[a-f0-9]+:(?<currentValue>v\\d+\\.\\d+\\.\\d+)',
      ],
      datasourceTemplate: 'github-tags',
      depNameTemplate: 'siderolabs/talos',
      versioningTemplate: 'semver',
    },
  ],
}
